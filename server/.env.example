# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Use your provider's POOLED connection string in production (not the direct
# host-only URL) so idle connections are recycled and you avoid "kind: Closed".
#
# Neon:    Dashboard → Connection string → "Pooled" → copy URL
# Supabase: Settings → Database → "Transaction pooler" (port 6543)
# Render:  Use the internal/external URL; add ?sslmode=require if needed
#
# Example (Neon pooled):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# Optional query params (append with &):
#   connect_timeout=15
#   pool_timeout=30
#
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

PORT=4000
NODE_ENV=development

# Local frontends (comma-separate multiple origins)
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174,http://localhost:5175"

# Production on Render — use your exact Netlify URLs (https, no trailing slash)
# CLIENT_URL="https://your-player-site.netlify.app"
# ADMIN_URL="https://your-admin-site.netlify.app"
# ALLOWED_ORIGINS="https://preview-branch.netlify.app"

ADMIN_SECRET="change_me_strong_admin_password"
SESSION_SECRET="change_me_long_random_string"

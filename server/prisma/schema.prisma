// Multiplayer stock market simulator — database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  WAITING
  ACTIVE
  ENDED
}

enum TradeAction {
  BUY
  SELL
  HOLD
}

enum StockTicker {
  AERO
  GRNV
  NXBK
  PHRX
}

model Player {
  id           String   @id @default(cuid())
  name         String
  phone        String
  sessionToken String   @unique
  createdAt    DateTime @default(now())

  hostedRooms  Room[]       @relation("RoomHost")
  roomPlayers  RoomPlayer[]
  trades       Trade[]
}

model Room {
  id        String     @id @default(cuid())
  code      String     @unique @db.Char(4)
  status    RoomStatus @default(WAITING)
  hostId    String
  createdAt DateTime   @default(now())

  host       Player       @relation("RoomHost", fields: [hostId], references: [id])
  players    RoomPlayer[]
  gameRounds GameRound[]
}

model RoomPlayer {
  id        String   @id @default(cuid())
  roomId    String
  playerId  String
  cash      Int      @default(10000)
  portfolio Json     @default("{}")
  joinedAt  DateTime @default(now())

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roomId, playerId])
  @@index([roomId])
  @@index([playerId])
}

model NewsCard {
  id              String @id @default(cuid())
  headline        String
  affectedStocks  Json
  priceDeltas     Json

  gameRounds GameRound[]
}

model GameRound {
  id          String   @id @default(cuid())
  roomId      String
  roundNumber Int
  newsCardId  String
  stockPrices Json
  createdAt   DateTime @default(now())

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  newsCard NewsCard @relation(fields: [newsCardId], references: [id])
  trades   Trade[]

  @@unique([roomId, roundNumber])
  @@index([roomId])
}

model Trade {
  id       String      @id @default(cuid())
  roundId  String
  playerId String
  stock    StockTicker
  action   TradeAction
  quantity Int         @default(0)

  round  GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId, stock])
  @@index([roundId])
  @@index([playerId])
}
